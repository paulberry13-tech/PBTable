From 345d83551845379b9a7a267821f47f93e1992e58 Mon Sep 17 00:00:00 2001
From: paulberry13-tech <paulberry13@googlemail.com>
Date: Sat, 26 Sep 2026 11:56:31 +0100
Subject: [PATCH] Brand link previews on twoclear.co.uk club sites
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

WhatsApp, iMessage and Facebook build link cards from <head> without running
the page's JavaScript, so a shared twoclear link still previewed as
"PBTable: your club's pickleball hub" with the PBTable logo. A Netlify edge
function now rewrites the title, description, site name and image for
*.twoclear.co.uk, including the club's own name ("Swindon Pickleball Club ·
twoclear"), looked up with the public key and abandoned after 1.5s. Every
other host, pbtable included, passes through untouched, and any failure
serves the page unchanged. og.png is the white badge on brand navy, opaque
so it holds up in dark-mode chat apps.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 netlify/edge-functions/twoclear-preview.js |  76 +++++++++++++++++++++
 site/brand/twoclear/og.png                 | Bin 0 -> 13556 bytes
 2 files changed, 76 insertions(+)
 create mode 100644 netlify/edge-functions/twoclear-preview.js
 create mode 100644 site/brand/twoclear/og.png

diff --git a/netlify/edge-functions/twoclear-preview.js b/netlify/edge-functions/twoclear-preview.js
new file mode 100644
index 0000000..ce76183
--- /dev/null
+++ b/netlify/edge-functions/twoclear-preview.js
@@ -0,0 +1,76 @@
+// Link-preview crawlers (WhatsApp, iMessage, Facebook) read <head> without running the page's
+// JavaScript, so the twoclear branding index.html applies in the browser never reaches them.
+// This rewrites the preview tags for *.twoclear.co.uk only; every other host passes straight through.
+
+const SUPABASE_URL = 'https://kxvtqsmjlhlajkoyejwk.supabase.co';
+const SUPABASE_KEY = 'sb_publishable_B7pUA8KnDogi3xI7RX50XA_wL4pal7_';
+
+const escapeHtml = (s) =>
+  s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
+
+async function clubName(slug) {
+  try {
+    const res = await fetch(
+      `${SUPABASE_URL}/rest/v1/clubs?select=name&slug=eq.${encodeURIComponent(slug)}`,
+      {
+        headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}` },
+        signal: AbortSignal.timeout(1500),
+      },
+    );
+    if (!res.ok) return null;
+    const rows = await res.json();
+    return (rows[0] && rows[0].name) || null;
+  } catch {
+    return null;
+  }
+}
+
+function rebrand(html, host, name) {
+  const title = name ? `${name} · twoclear` : "twoclear: your club's pickleball hub";
+  const description = name
+    ? `${name}. Live pickleball ratings, session line-ups and social play on twoclear.`
+    : 'Live pickleball club ratings, session line-ups and social play, powered by twoclear.';
+  const image = `https://${host}/brand/twoclear/og.png`;
+
+  // Replacer functions, not '$1…' strings, so a '$' in a club name cannot be read as a group reference.
+  const setMeta = (attr, key, value) => {
+    html = html.replace(
+      new RegExp(`(<meta ${attr}="${key}" content=")[^"]*(")`),
+      (_, open, close) => open + escapeHtml(value) + close,
+    );
+  };
+  html = html.replace(/<title>[^<]*<\/title>/, () => `<title>${escapeHtml(title)}</title>`);
+  setMeta('name', 'description', description);
+  setMeta('property', 'og:site_name', 'twoclear');
+  setMeta('property', 'og:title', title);
+  setMeta('name', 'twitter:title', title);
+  setMeta('property', 'og:image', image);
+  setMeta('name', 'twitter:image', image);
+  return html;
+}
+
+export default async (request, context) => {
+  const host = new URL(request.url).hostname.toLowerCase();
+  const match = host.match(/^([a-z0-9-]+)\.twoclear\.co\.uk$/);
+  if (!match) return;
+
+  const response = await context.next();
+  if (!response.ok || !(response.headers.get('content-type') || '').includes('text/html')) return response;
+
+  const html = await response.text();
+  let body = html;
+  try {
+    const slug = match[1];
+    const name = slug === 'www' || slug === 'demo' ? null : await clubName(slug);
+    body = rebrand(html, host, name);
+  } catch {
+    // Fail open: an unbranded preview is better than a broken club site.
+  }
+
+  const headers = new Headers(response.headers);
+  headers.delete('content-length');
+  headers.delete('content-encoding');
+  return new Response(body, { status: response.status, headers });
+};
+
+export const config = { path: ['/', '/index.html'] };
